Practical 2B: Decision-Making Statements
1. if-else Statement
void main() {
  int marks = 75;

  if (marks >= 40) {
    print("Pass");
  } else {
    print("Fail");
  }
}

2. if-else-if Ladder
void main() {
  int marks = 85;

  if (marks >= 90) {
    print("Grade A");
  } else if (marks >= 75) {
    print("Grade B");
  } else if (marks >= 50) {
    print("Grade C");
  } else {
    print("Fail");
  }
}

3. switch-case Statement
void main() {
  int day = 5;

  switch (day) {
    case 1:
      print("Monday");
      break;
    case 2:
      print("Tuesday");
      break;
    case 3:
      print("Wednesday");
      break;
    case 4:
      print("Thursday");
      break;
    case 5:
      print("Friday");
      break;
    case 6:
      print("Saturday");
      break;
    default:
      print("Invalid Day");
  }
}

Practical 2C: Looping Statements
1. for Loop
void main() {
  int n = 7;
  for (int i = 0; i < n; i++) {
    print("Today is Wednesday");
  }
}
2. while Loop
void main() {
  int i = 1;

  while (i <= 5) {
    print(i);
    i++;
  }
}





